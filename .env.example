# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Runtime ---
APP_ENV=local
LOG_LEVEL=INFO
# Paper trading only: `paper` is the ONLY accepted value. No live broker exists.
TRADING_MODE=paper

# --- LLM (multi-provider) ---
# One of: fake | openai | anthropic | gemini
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Embeddings (episodic memory) ---
# One of: fake | openai | gemini
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5432/trading

# --- Agent tools ---
# P-09 Financial Research Agent (`POST /research`)
RESEARCH_API_URL=http://localhost:8000
RESEARCH_API_TIMEOUT_S=60
# One of: yahoo | fake
MARKET_DATA_PROVIDER=yahoo
WATCHLIST=AAPL,MSFT,NVDA,SPY

# --- Deterministic risk limits (enforced outside the LLM) ---
RISK_MAX_POSITION_PCT=0.10
RISK_MAX_GROSS_EXPOSURE_PCT=0.80
RISK_STOP_LOSS_PCT=0.08
RISK_MAX_TRADES_PER_DAY=5

# --- Paper broker ---
PAPER_INITIAL_CASH=100000
PAPER_COMMISSION_BPS=1
PAPER_SLIPPAGE_BPS=5

# --- Agent budgets ---
AGENT_MAX_STEPS=8
AGENT_MAX_COST_USD_PER_DECISION=0.05
MEMORY_TOP_K=5

# --- GCP ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1
GCS_ARTIFACTS_BUCKET=your-artifacts-bucket
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Orchestration ---
AGENT_API_URL=http://api:8080
AIRFLOW_UID=50000
